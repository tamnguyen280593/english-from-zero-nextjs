          "lines": [
            { "speaker": "Minh", "text": "Hello! My name is Minh.", "textVi": "Xin chào! Tên tôi là Minh.", "ipa": "/həˈloʊ maɪ neɪm ɪz mɪn/" },
            { "speaker": "Emma", "text": "Hi Minh! I'm Emma. Nice to meet you!", "textVi": "Chào Minh! Tôi là Emma. Rất vui được gặp bạn!", "ipa": "/haɪ mɪn aɪm ˈɛmə naɪs tuː miːt juː/" },
            { "speaker": "Minh", "text": "Nice to meet you too, Emma!", "textVi": "Mình cũng rất vui được gặp bạn, Emma!", "ipa": "/naɪs tuː miːt juː tuː ˈɛmə/" }
          ]
        }
      ],
      "practice": [
